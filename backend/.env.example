# Application Configuration
APP_NAME="CareerCompass Backend"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER="postgresql://neondb_owner:npg_kdgr8LnY7Aol@ep-wispy-pond-b4cy3t5i-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="ManipulatorAI"
# DATABASE_URL="postgresql+psycopg2://postgres:your_secure_password@localhost:5432/careercompass"

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==============================================================================
# Multi-Provider AI Configuration
# ==============================================================================
# Select active provider: "none" | "gemini" | "groq" | "openai"
AI_PROVIDER="none"
AI_TIMEOUT_SECONDS=30.0

# 1. Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# 2. Groq (https://console.groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ==============================================================================
# RAG & Embeddings Configuration (pgvector)
# ==============================================================================
# Embedding provider: "mock" (default/offline test) | "gemini" | "openai"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="career-embed-384"
EMBEDDING_DIM=384
RAG_ENABLED=True
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.65

# ==============================================================================
# Ingestion Pipeline Configuration
# ==============================================================================
MAX_UPLOAD_SIZE_BYTES=10485760
INGESTION_CHUNK_SIZE=800
INGESTION_CHUNK_OVERLAP=150
INGESTION_API_KEY=""

# ==============================================================================
# Human Counsellor Escalation & Handoff Configuration
# ==============================================================================
HUMAN_COUNSELLOR_SERVICE_URL=""
HUMAN_COUNSELLOR_EMAIL=""
HUMAN_COUNSELLOR_AUTO_ESCALATE=True